# Публичный REST API n8n. Ключ выдаётся в n8n: Settings → n8n API.
N8N_API_URL=https://n8n.example.com
N8N_API_KEY=

# Необязательно: токен встроенного MCP n8n (Settings → Instance-level MCP). Даёт n8n-mcp доступ
# к реальным справочникам credentials (каналы Slack, листы Sheets) и к истории версий n8n.
N8N_MCP_ACCESS_TOKEN=
